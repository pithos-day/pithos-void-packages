# Template file for 't3code'
pkgname=t3code
version=0.1.8
revision=2
archs="x86_64"
short_desc="GUI for coding agents, served from the terminal to the browser"
license="MIT"
homepage="https://t3.codes"
distfiles="https://github.com/pingdotgg/t3code/releases/download/v${version}/t3-${version}-linux-x64.tar.gz
 https://raw.githubusercontent.com/pingdotgg/t3code/v${version}/LICENSE"
checksum="b9c49dc00c23fbbc5961bdaff2d88e556d96c8dbd638c4501e2937c70650a9e5
 935d8f2af0c703f9c39517ee57cc4930b19d02d533be930b63f0e82f93614b43"
skip_extraction="LICENSE"
nostrip=yes
nopie=yes
# 同梱されている musl 向けの prebuilt は依存解決の対象から外す
_modules="/usr/lib/t3code/node_modules"
skiprdeps="${_modules}/@yuuang/ffi-rs-linux-x64-musl/ffi-rs.linux-x64-musl.node
 ${_modules}/@ff-labs/fff-bin-linux-x64-musl/libfff_c.so
 ${_modules}/@koromix/koffi-linux-x64/musl_x64/koffi.node"

do_install() {
	vmkdir usr/lib/t3code
	vcopy "*" usr/lib/t3code

	vmkdir usr/bin
	ln -s ../lib/t3code/t3 ${DESTDIR}/usr/bin/t3

	vlicense ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE
}

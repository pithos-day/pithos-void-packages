# Template file for 'sonobus'
pkgname=sonobus
version=1.7.2
revision=1
build_style=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release"
hostmakedepends="pkg-config"
makedepends="alsa-lib-devel jack-devel opus-devel libX11-devel libXext-devel
 libXinerama-devel libXrandr-devel libXcursor-devel MesaLib-devel
 freetype-devel libcurl-devel"
# JUCE が実行時に dlopen するため、自動では依存に入らない
depends="libX11 libXext libXinerama libXrandr libXcursor"
short_desc="High quality network audio streaming"
license="GPL-3.0-or-later"
homepage="https://sonobus.net"
distfiles="https://github.com/sonosaurus/sonobus/archive/refs/tags/${version}.tar.gz"
checksum=f09954555a281ff254971ef3af5f9d041102143c6454958b15a11a380680a55d

do_install() {
	local _artefacts="build/SonoBus_artefacts/Release"

	vbin ${_artefacts}/Standalone/sonobus
	vinstall linux/sonobus.desktop 644 usr/share/applications
	vinstall "images/sonobus_logo@2x.png" 644 usr/share/pixmaps sonobus.png

	if [ -d ${_artefacts}/VST3/SonoBus.vst3 ]; then
		vmkdir usr/lib/vst3
		vcopy ${_artefacts}/VST3/SonoBus.vst3 usr/lib/vst3
	fi
	if [ -d ${_artefacts}/LV2/SonoBus.lv2 ]; then
		vmkdir usr/lib/lv2
		vcopy ${_artefacts}/LV2/SonoBus.lv2 usr/lib/lv2
	fi
}
